{
  "name": "react-sale",
  "version": "1.0.0",
  "private": true,
  "description": "Procurement dashboard for tracking purchases and supplier management",
  "dependencies": {
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "node --no-warnings node_modules/.bin/react-scripts start",
    "build": "node --no-warnings node_modules/.bin/react-scripts build",
    "test": "node --no-warnings node_modules/.bin/react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
